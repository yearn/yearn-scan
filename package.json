{
  "name": "yearn-scan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.ts",
    "test:browser": "pnpm build && node --test test/browser.smoke.ts",
    "check": "pnpm typecheck && pnpm test",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "upload": "node scripts/upload.mjs",
    "delete-report": "node scripts/delete-report.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@types/node": "24.13.4",
    "miniflare": "4.20260515.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "wrangler": "4.92.0"
  }
}
