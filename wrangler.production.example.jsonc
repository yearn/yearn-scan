{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yearn-scan",
  "main": "src/index.ts",
  "account_id": "REPLACE_ACCOUNT_ID",
  "compatibility_date": "2026-05-15",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ORIGIN": "https://scan.yearn.dev",
    "ACCESS_ISSUER": "https://REPLACE_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_READ_APPLICATION_AUDIENCE"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yearn-scan",
      "database_id": "REPLACE_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "scan.yearn.dev",
      "custom_domain": true
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
